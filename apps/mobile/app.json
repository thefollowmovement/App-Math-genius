{
  "expo": {
    "name": "Math Genius",
    "slug": "math-genius",
    "version": "0.1.0",
    "scheme": "mathgenius",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le QR code affiché par ton parent pour relier cet appareil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
